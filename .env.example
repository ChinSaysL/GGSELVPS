GENGINE_API_KEY=
GENGINE_BASE_URL=https://api.g-engine.net

GGSEL_API_KEY=
GGSEL_BASE_URL=https://seller.ggsel.com

DIGISELLER_API_KEY=
DIGISELLER_BASE_URL=https://api.digiseller.com

DATABASE_URL=sqlite:///./data/app.db

PLATFORM_FEE_PERCENT=0.06
FX_BUFFER_PERCENT=0.03
RISK_BUFFER_PERCENT=0.02
SAFETY_BALANCE_PERCENT=0.15

MIN_PROFIT_CHEAP_USD=0.50
MIN_PROFIT_MEDIUM_USD=1.00
MIN_PROFIT_EXPENSIVE_USD=2.00

MANUAL_USD_RUB_RATE=
DEFAULT_CURRENCY=RUB

ORDER_POLL_INTERVAL_SECONDS=60
PRODUCT_SYNC_INTERVAL_MINUTES=60
STOCK_SYNC_INTERVAL_MINUTES=5
PRICE_SYNC_INTERVAL_MINUTES=30
SCHEDULER_ENABLED=true

LOG_LEVEL=INFO

# Digiseller category mapping for auto-created offers.
# owner values: 0 own store, 1 Plati, 2 WMCENTRE, 3 GGSEL.
DIGISELLER_CATEGORY_ID=
DIGISELLER_CATEGORY_OWNER=3
DIGISELLER_CONTENT_TYPE=Text

# Bilingual listing templates.
# Supported placeholders: {supplier_title}, {denomination}, {currency}, {region}, {category}, {delivery_type}, {delivery_type_ru}
LISTING_TITLE_TEMPLATE_EN=[AUTO 24/7] Steam Gift Card {denomination} {currency} | {region}
LISTING_TITLE_TEMPLATE_RU=[AUTO 24/7] Steam Gift Card {denomination} {currency} | {region}
LISTING_DESCRIPTION_TEMPLATE_EN=Instant digital delivery.\nProduct: {supplier_title}\nRegion: {region}\nDenomination: {denomination} {currency}\nDelivery format: {delivery_type}\nSupport: contact us in chat if you need help.
LISTING_DESCRIPTION_TEMPLATE_RU=Мгновенная цифровая доставка.\nТовар: {supplier_title}\nРегион: {region}\nНоминал: {denomination} {currency}\nФормат выдачи: {delivery_type_ru}\nПоддержка: если нужна помощь, напишите нам в чат.
